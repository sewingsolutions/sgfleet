root = true

[*]
indent_style = space
insert_final_newline = true
end_of_line = lf
trim_trailing_whitespace = true

[*.ts]
indent_size = 2
tab_width = 2

[*.tsx]
indent_size = 2
tab_width = 2

[*.js]
indent_size = 2
tab_width = 2

[*.jsx]
indent_size = 2
tab_width = 2

[*.json]
indent_size = 2
tab_width = 2

[*.yaml]
indent_size = 2
tab_width = 2

[*.yml]
indent_size = 2
tab_width = 2

[*.sh]
indent_size = 2
tab_width = 2

[*Dockerfile]
indent_size = 2
tab_width = 2

[*.py]
indent_size = 4
tab_width = 4

[*.pyi]
indent_size = 4
tab_width = 4
