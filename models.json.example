{
  "models": [
    {
      "id": "example-model",
      "name": "Example Model",
      "image": "lmsysorg/sglang:v0.5.16",
      "model_path": "/models/example-model-dir",
      "context_length": 131072,
      "max_output_length": 8192,
      "port": 30000,
      "container_name": "sgfleet-example-model",
      "container_alias": "sgfleet-example-model",
      "model_alias": "sgfleet-api-model",
      "active": false,
      "grace_period": 10,
      "environment": {
        "PYTORCH_CUDA_ALLOC_CONF": "expandable_segments:True",
        "SGLANG_ALLOW_OVERWRITE_LONGER_CONTEXT_LEN": "1",
        "SGLANG_USE_BREAKABLE_CUDA_GRAPH": "true"
      },
      "gpu": "auto",
      "command_flags": [
        "--context-length", "131072",
        "--kv-cache-dtype", "fp8_e4m3",
        "--mem-fraction-static", "0.90",
        "--chunked-prefill-size", "8192",
        "--enable-metrics",
        "--enable-flashinfer"
      ]
    }
  ]
}
