# SGFleet configuration — infrastructure only
# Secrets are managed via the web UI after first boot

# Host directories
MODELS_DIR="/models"
HOST_MODELS_DIR="/models"
DATA_DIR="./data"
LOGS_DIR="./logs"

# Network
SGFLEET_BASE_URL="https://your-gateway-domain.example.com/v1"

# Encryption
# SGFLEET_ENCRYPTION_KEY is auto-generated by init.sh
SGFLEET_ENCRYPTION_KEY=""

# Monitoring
# PROMETHEUS_HOST=""  # omit to disable metrics export
